BLOCKFROST_API_KEY_PREPROD=

# Organization Workspaces the worker may serve besides Personal (comma separated ids).
# token2049-origins-hackathon-2026-nws2r7 -> add its organization id here.
ALLOWED_ORGANIZATION_IDS=

# Agent-to-agent buyer (scripts/a2a-demo.mjs). The key must be ReadAndPay and scoped to the buyer wallet.
MPS_BUYER_TOKEN=
A2A_SELLER_URL=
A2A_AGENT_IDENTIFIER=
ORIGIN_API_URL=
ORIGIN_API_KEY=

# Trip Desk (paid agent-to-agent hops, all settled through Masumi on Cardano Preprod)
A2A_PAID_SEARCH=1        # hotel and flight search, 1 test USDM each
A2A_PAID_KNOWLEDGE=1     # destination knowledge desk, 0.5 test USDM
A2A_AUDIT=1              # Trip Auditor reviews every plan, 0.5 test USDM
A2A_TASK_CAP_ATOMIC=4000000   # most one task may spend on other agents (test USDM, 6 decimals)
A2A_MAX_PER_HOUR=24
# Optional: buy the audit from a separately registered auditor identity instead of the main seller.
A2A_AUDIT_URL=
A2A_AUDIT_AGENT_IDENTIFIER=
WORKER_CONCURRENCY=4     # agent turns running side by side
# Guest on LiteAPI sandbox bookings unless the request says "under <name>".
GUEST_GIVEN_NAME=
GUEST_FAMILY_NAME=
GUEST_EMAIL=
